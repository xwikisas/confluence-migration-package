<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.xwiki.confluence</groupId>
    <artifactId>confluence-migration-package</artifactId>
    <version>1.1.19-SNAPSHOT</version>
  </parent>
  <artifactId>confluence-migration-package-xip</artifactId>
  <name>Confluence Migration Toolkit - XIP</name>
  <packaging>xip</packaging>
  <description>Package containing everything needed to install Confluence Migration Toolkit offline.</description>
  <dependencies>
    <dependency>
      <groupId>com.xwiki.pro</groupId>
      <artifactId>xwiki-pro-package</artifactId>
      <version>${xwiki-pro.version}</version>
      <type>xar</type>
      <scope>provided</scope>
      <exclusions>
        <!-- For some reasons, the analytics application pulls jersey-server and jersey-client,
             which pull jakarta.ws.rs:jakarta.ws.rs-api, which is banned. So we exclude that. -->
        <exclusion>
          <groupId>org.glassfish.jersey.core</groupId>
          <artifactId>jersey-server</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.glassfish.jersey.core</groupId>
          <artifactId>jersey-client</artifactId>
        </exclusion>
        <!-- active directory has a transitive dependency to security-script, which doesn't exist anymore -->
        <exclusion>
          <groupId>org.xwiki.platform</groupId>
          <artifactId>xwiki-platform-security-script</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.xwiki.confluence</groupId>
      <artifactId>confluence-migration-package-ui</artifactId>
      <version>${project.version}</version>
      <type>xar</type>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.xwiki.commons</groupId>
          <artifactId>xwiki-commons-tool-extension-plugin</artifactId>
          <!-- Needs the fix of XCOMMONS-3003, otherwise com.atlassian.sal:sal-api (pulled by the JIRA macro) is
               stored with a wrong id and offline installs fail. 15.10.9 is the first 15.10.x with the fix.
               Don't use 16.0 to 16.3, they don't have it. Can be replaced with ${commons.version} once the parent
               is on a version that includes the fix (15.10.9+ or 16.4.0+). -->
          <version>15.10.16</version>
          <configuration>
            <coreExtensions>
              <!-- We exclude what is already in the WAR. -->
              <coreExtension>
                <groupId>org.xwiki.platform</groupId>
                <artifactId>xwiki-platform-distribution-war-dependencies</artifactId>
                <version>${platform.version}</version>
                <type>pom</type>
              </coreExtension>
            </coreExtensions>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- We need this, otherwise the extension-plugin fails to save the descriptor of "bundle" artifacts. -->
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <extensions>true</extensions>
      </plugin>
    </plugins>
  </build>
</project>
